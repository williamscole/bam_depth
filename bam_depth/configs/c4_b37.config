# Site config for c4, GRCh37 / hg19 (b37 contig names, no chr prefix)
# Sourced by bam_depth.sh (plain bash KEY="value" lines).

BUILD="b37"
REF_FASTA="/zivlab/data3/colew/datasets/ref/human_g1k_v37.fasta"   # needs a .fai next to it
EXOME_TARGET_BED="/zivlab/data3/geri_wes/hg19_exome_v2.0.2_merged_probes_sorted_validated.annotated.bed"  # .bed or .bed.gz
STRIP_CHR="true"    # target BED is chr-prefixed (hg19); BAMs use 1,2,...
